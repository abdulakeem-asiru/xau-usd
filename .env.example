# MetaApi (bridges to your MT5 broker account — see README for provisioning steps)
METAAPI_TOKEN=your-metaapi-api-token
METAAPI_ACCOUNT_ID=your-metaapi-account-id
METAAPI_DOMAIN=agiliumtrade.agiliumtrade.ai
# The symbol name for gold exactly as it appears in your MT5 terminal's Market Watch —
# brokers vary (XAUUSD, XAUUSDm, GOLD, GOLDm, ...). Check yours before deploying.
INSTRUMENT=XAUUSD
# MetaApi/MT5 timeframe string, e.g. 15m, 30m, 1h, 4h — not OANDA-style "M15".
CANDLE_TIMEFRAME=15m
# There's no single practice/live toggle for MT5 the way OANDA has a base-URL swap —
# demo vs live is a property of WHICH account METAAPI_ACCOUNT_ID points to. Set this to
# true only after you've personally verified that account is a real live MT5 account,
# not a demo. Leave false for practice/demo trading.
BROKER_LIVE_ACCOUNT_CONFIRMED=false

# Telegram
TELEGRAM_BOT_TOKEN=123456:your-bot-token
OWNER_TELEGRAM_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
TELEGRAM_WEBHOOK_BASE_URL=https://your-app.up.railway.app

# Dashboard auth
DASHBOARD_USERNAME=admin
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
DASHBOARD_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash
JWT_SECRET=generate-a-long-random-string

# Database (Railway sets this automatically via the Postgres plugin reference variable)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/xau_bot

# Trading loop
POLL_INTERVAL_SECONDS=30
